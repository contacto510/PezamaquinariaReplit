# PLANTILLA SIN CREDENCIALES REALES.
# Completar de forma privada. No subir un .env real a GitHub.
# Este proyecto recibe variables del entorno: no carga .env automaticamente.
# En un servidor externo, configurar las variables en el proveedor
# o usar un mecanismo de carga de .env compatible con el runtime.

NODE_ENV=production
PORT=5000

# Conexion PostgreSQL utilizada por la aplicacion.
# Para una migracion, usar la conexion correcta de la base de destino;
# no confundir una copia de desarrollo con los datos reales.
DATABASE_URL=

# Acceso interno. Conservar los valores si no se desea cambiar el acceso.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Webhook de WordPress: minimo 32 caracteres y mismo valor en ambos sitios.
WORDPRESS_WEBHOOK_SECRET=

# Almacenamiento actual. Estas variables NO hacen portable el servicio:
# fuera de Replit se debe revisar autenticacion y acceso a las fotos.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# Referencia usada por algunas rutas antiguas de almacenamiento.
REPLIT_BUCKET_ID=

# Integracion opcional con Zoho.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
